<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="WHOAnthroPlus.PC.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
            <section name="PC.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="WHOAnthroPlus.PC.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <WHOAnthroPlus.PC.Properties.Settings>
            <setting name="DBRelativePath" serializeAs="String">
                <value>WHOAnthroPlus.sdf</value>
            </setting>
            <setting name="LogRelativePath" serializeAs="String">
                <value>Log.xml</value>
            </setting>
            <setting name="DBMaximumSize" serializeAs="String">
                <value>2048</value>
            </setting>
        </WHOAnthroPlus.PC.Properties.Settings>
    </applicationSettings>
    <userSettings>
        <WHOAnthroPlus.PC.Properties.Settings>
            <setting name="IAAutoID" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="AddressRefData" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="AddressLists" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="IAAdditionalDataTemplate" serializeAs="String">
                <value>&lt;Data&gt;&lt;Cat ID="Maturation" Descr=""&gt;&lt;Txt ID="Menarche/spermarche" Descr=""&gt;&lt;/Txt&gt;&lt;Txt ID="Self-reported" Descr=""&gt;&lt;/Txt&gt;&lt;/Cat&gt;&lt;Cat ID="Physical activity" Descr="hours per week"&gt;&lt;Num Min="0" Max="140" ID="Sport" Descr="" /&gt;&lt;Num Min="0" Max="140" ID="TV/computer" Descr="" /&gt;&lt;/Cat&gt;&lt;Cat ID="Food" Descr=""&gt;&lt;Num Min="0" Max="10" ID="Fruit&amp;amp;veg portions / day" Descr="" /&gt;&lt;/Cat&gt;&lt;Cat ID="Health" Descr=""&gt;&lt;Txt ID="Blood pressure" Descr=""&gt;&lt;/Txt&gt;&lt;Txt ID="Blood lipids" Descr=""&gt;&lt;/Txt&gt;&lt;/Cat&gt;&lt;/Data&gt;</value>
            </setting>
            <setting name="Language" serializeAs="String">
                <value>en</value>
            </setting>
            <setting name="DoSettingsUpgrade" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="UseEnterForNextControl" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="DisableDefaultUpDownBehaviour" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="EnableRefDataCaching" serializeAs="String">
                <value>True</value>
            </setting>
        </WHOAnthroPlus.PC.Properties.Settings>
    </userSettings>
</configuration>